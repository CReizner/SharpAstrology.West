<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SharpAstrology.West</PackageId>
        <PackageTags>Astrology</PackageTags>
        <Version>0.2.0</Version>
        <PackageReleaseNotes>0.2.0: DecanateOf is documented to count in the zodiac of the chart. A chart carries exactly one zodiac since SharpAstrology.Base 0.14.0, and CalculationMode says which one, so a sidereally calculated chart gives thirds of a constellation. No behaviour changed, the floor on SharpAstrology.Base moved to 0.14.0.</PackageReleaseNotes>
        <Authors>Christian Reizner</Authors>
        <IsPackable>true</IsPackable>
        <Description>
            This package extends SharpAstrology with functions that are relevant for western astrology.
        </Description>
        <RepositoryUrl>https://github.com/CReizner/SharpAstrology.West</RepositoryUrl>
        <PackageProjectUrl>https://github.com/CReizner/SharpAstrology.West</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="$(PackageReadmeFile)"/>
    </ItemGroup>
    
    <PropertyGroup>
        <SharpAstrologyBaseVersion>[0.14.0,)</SharpAstrologyBaseVersion>
    </PropertyGroup>

    <ItemGroup Condition="Exists('..\SharpAstrology.Base\SharpAstrology.Base.csproj')">
        <ProjectReference Include="..\SharpAstrology.Base\SharpAstrology.Base.csproj" />
    </ItemGroup>

    <ItemGroup Condition="!Exists('..\SharpAstrology.Base\SharpAstrology.Base.csproj')">
        <PackageReference Include="SharpAstrology.Base" Version="$(SharpAstrologyBaseVersion)" />
    </ItemGroup>

</Project>
